@TadbirQueryAI.Api_HostAddress = http://localhost:5251
@accessToken =
@refreshToken =

### Login (seeded admin in Development)
POST {{TadbirQueryAI.Api_HostAddress}}/auth/login
Content-Type: application/json

{
      "email": "admin@tadbir.local",
  "password": "Admin@12345"
}

### Refresh
POST {{TadbirQueryAI.Api_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Me
GET {{TadbirQueryAI.Api_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}

### Query (requires Bearer token)
POST {{TadbirQueryAI.Api_HostAddress}}/query
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "query": "Show top 10 policies"
}

### Logout
POST {{TadbirQueryAI.Api_HostAddress}}/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
